<header class="storefront-header" data-mavile-header>
  <div class="storefront-header__bar">
    <div class="storefront-header__bar-start" aria-hidden="true"></div>

    <a href="{{ routes.root_url }}" class="storefront-header__logo-link" aria-label="{{ 'general.header.home' | t }}">
      <img
        src="{{ 'mavile-logo.svg' | asset_url }}"
        alt="{{ shop.name }}"
        class="storefront-header__logo"
        width="128"
        height="26"
      >
    </a>

    <div class="storefront-header__actions">
      {% render 'mavile-language-switcher' %}

      <button
        type="button"
        class="storefront-header__icon-btn storefront-header__hamburger"
        aria-label="{{ 'general.header.open_menu' | t }}"
        aria-expanded="false"
        aria-controls="storefront-mobile-menu"
        data-mavile-menu-toggle
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>

      <a href="{{ routes.account_url }}" class="storefront-header__icon-btn" aria-label="{{ 'general.header.account' | t }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>

      <a href="{{ routes.cart_url }}" class="storefront-header__icon-btn" aria-label="{{ 'general.header.cart' | t: count: cart.item_count }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 01-8 0"></path>
        </svg>
        <span class="storefront-header__cart-count">({{ cart.item_count }})</span>
      </a>
    </div>
  </div>

  <div class="storefront-header__nav-row">
    {% render 'mavile-nav', menu: section.settings.menu, variant: 'header' %}
  </div>

  <div class="storefront-header__mobile-menu" id="storefront-mobile-menu" data-mavile-mobile-menu hidden>
    {% render 'mavile-nav', menu: section.settings.menu, variant: 'mobile' %}
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
