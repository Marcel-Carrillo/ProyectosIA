# ──────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT VARIABLES — Reference for local development
#
#  Development (host-local):   copy to  .env
#  Development (Docker):       copy to  .env.docker
#  Production (Lambda):        all vars are stored in AWS SSM Parameter Store
#                              and read by serverless.yml at deploy time.
#                              Update them with:
#                              aws ssm put-parameter --name /ecommerce/prod/VARNAME \
#                                --value "VALUE" --type SecureString --overwrite
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────────────────────────
# Host-local (backend on host, Postgres exposed on localhost:5432):
DATABASE_URL="postgresql://ecommerceUser:ecommercePassword@localhost:5432/ecommerceDb"
# Docker (backend inside docker-compose, use service name 'db'):
# DATABASE_URL="postgresql://ecommerceUser:ecommercePassword@db:5432/ecommerceDb"

PORT=3000
NODE_ENV=development

# URLs — dev uses localhost; prod values come from SSM
FRONTEND_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3000

# ── Admin auth ─────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPass1
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-min-32-chars
ADMIN_JWT_EXPIRES_IN=15m
COOKIE_SECRET=change-me-cookie-secret-min-32-chars

# ── Customer auth ──────────────────────────────────────────────────────────────
CUSTOMER_JWT_SECRET=change-me-customer-jwt-secret-min-32-chars
CUSTOMER_JWT_EXPIRES_IN=15m

# ── SMTP (emails) ─────────────────────────────────────────────────────────────
# Dev: Mailpit catches all outgoing mail — no real SMTP credentials needed
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=mcarhue@mavile.es
# Set true in production to fail hard if SMTP is unreachable (serverless.yml sets this)
SMTP_STRICT=false
MAILPIT_API_URL=http://localhost:8025/api/v1
# Production: Amazon SES eu-north-1 (SMTP_USER = IAM access key, SMTP_PASS = derived SES password)
# SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<IAM AccessKeyId of ecommerce-ses-smtp user>
# SMTP_PASS=<SES SMTP password derived from IAM secret key>

# ── Welcome coupon ─────────────────────────────────────────────────────────────
# Sent on new customer registration. One use per customer account.
WELCOME_COUPON_PERCENT=15
WELCOME_COUPON_MIN_ORDER=0

# ── Stripe payments ───────────────────────────────────────────────────────────
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_test_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_test_webhook_secret

# ── CJ Dropshipping integration ────────────────────────────────────────────────
CJDROPSHIPPING_API_KEY=cj_test_replace_with_your_cj_dropshipping_api_key
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1
# Forces every supplier-order push to CJ to use isSandbox=1 (no real order, no
# real charge, no real shipment). Leave true until a future increment
# deliberately adds a real-order code path.
CJ_SANDBOX_ORDERS=true
# Optional: cap catalog sync in local dev. syncCatalog makes one fetchVariants
# API call PER PRODUCT on every page (cost = pages * (1 + pageSize)), not just
# one call per page — keep both small for local/manual testing against the
# live API to avoid burning rate-limit quota. Production sets its own values
# via serverless.yml/SSM (see docs/development_guide.md), not this file.
# CJ_SYNC_MAX_PAGES=1
# CJ_CATALOG_PAGE_SIZE=5
# Default markup multiplier applied to CjCatalogItem.supplierCost when an
# admin promotes an item (or the scheduled auto-provisioning job promotes
# one) without an explicit publicPrice. Formula:
#   publicPrice = roundToPsychological(supplierCost * markup + shipping)
# 1.6 = 60% margin on cost only; shipping is a flat add-on (not marked up).
# Never publish at raw cost.
CJ_DEFAULT_MARKUP_MULTIPLIER=1.6
# Flat shipping cost estimate (in the store's currency) ADDED after markup
# on cost, for every item, when no explicit publicPrice is given. A flat
# value (not a live CJ freight quote) deliberately — CJ's freight API is
# rate-limited to ~1 req/s, and calling it per item inside promote() would
# risk timing out the promote endpoint's Lambda for multi-item batches.
# Defaults to 0 (no shipping added) if unset.
CJ_DEFAULT_SHIPPING_ESTIMATE=8

# ── Supplier auto-provisioning (scheduled job) ────────────────────────────────
# Fallback Category.id used only when CJ taxonomy resolution fails during
# promotion (no CjCatalogItem.categoryId, or the CJ categories API is
# unavailable). Prefer real CJ categories; this is a safety net. Must
# reference an EXISTING Category row — create one (e.g. "Uncategorized")
# via the admin Category management UI/API first, then set its id here.
# If unset or invalid, promotion fails with CJ_PROMOTION_CATEGORY_REQUIRED
# when CJ resolution also fails.
CJ_DEFAULT_CATEGORY_ID=
# Kill-switch for the scheduled supplierAutoProvision job. Checked first on
# every invocation; the job short-circuits (no DB writes) unless this is
# exactly 'true'. Defaults to disabled in these template files.
SUPPLIER_AUTO_PROVISION_ENABLED=false

# ── OAuth (optional — leave empty unless testing OAuth flows locally) ──────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Production SSM parameters to create/update ────────────────────────────────
# aws ssm put-parameter --name /ecommerce/prod/DATABASE_URL        --value "..." --type SecureString --overwrite
# aws ssm put-parameter --name /ecommerce/prod/FRONTEND_URL        --value "https://mavile.es" --type String --overwrite
# aws ssm put-parameter --name /ecommerce/prod/API_PUBLIC_URL      --value "https://API_GATEWAY_URL/prod" --type String --overwrite
# aws ssm put-parameter --name /ecommerce/prod/ADMIN_JWT_SECRET    --value "..." --type SecureString --overwrite
# aws ssm put-parameter --name /ecommerce/prod/ADMIN_JWT_EXPIRES_IN --value "15m" --type String --overwrite
# aws ssm put-parameter --name /ecommerce/prod/CUSTOMER_JWT_SECRET --value "..." --type SecureString --overwrite
# aws ssm put-parameter --name /ecommerce/prod/CUSTOMER_JWT_EXPIRES_IN --value "15m" --type String --overwrite
# aws ssm put-parameter --name /ecommerce/prod/COOKIE_SECRET       --value "..." --type SecureString --overwrite
# aws ssm put-parameter --name /ecommerce/prod/SMTP_HOST           --value "email-smtp.eu-north-1.amazonaws.com" --type String --overwrite
# aws ssm put-parameter --name /ecommerce/prod/SMTP_PORT           --value "587" --type String --overwrite
# aws ssm put-parameter --name /ecommerce/prod/SMTP_SECURE         --value "false" --type String --overwrite
# aws ssm put-parameter --name /ecommerce/prod/SMTP_USER           --value "<IAM AccessKeyId of ecommerce-ses-smtp>" --type String --overwrite
# aws ssm put-parameter --name /ecommerce/prod/SMTP_PASS           --value "<SES SMTP derived password>" --type SecureString --overwrite
# aws ssm put-parameter --name /ecommerce/prod/SMTP_FROM           --value "mcarhue@mavile.es" --type String --overwrite
# aws ssm put-parameter --name /ecommerce/prod/STRIPE_SECRET_KEY   --value "sk_live_..." --type SecureString --overwrite
# aws ssm put-parameter --name /ecommerce/prod/STRIPE_PUBLISHABLE_KEY --value "pk_live_..." --type String --overwrite
# aws ssm put-parameter --name /ecommerce/prod/STRIPE_WEBHOOK_SECRET --value "whsec_..." --type SecureString --overwrite
# aws ssm put-parameter --name /ecommerce/prod/CJDROPSHIPPING_API_KEY --value "..." --type SecureString --overwrite
# aws ssm put-parameter --name /ecommerce/prod/CJ_API_BASE_URL --value "https://developers.cjdropshipping.com/api2.0/v1" --type String --overwrite
