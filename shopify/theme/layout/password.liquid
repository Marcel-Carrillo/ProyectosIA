<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ shop.name }}</title>
    {{ 'mavile-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'mavile-base.css' | asset_url | stylesheet_tag }}
    {{ 'mavile-storefront.css' | asset_url | stylesheet_tag }}
    {{ 'mavile-shopify.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="storefront-root">
    <main class="storefront-account">
      <img src="{{ 'mavile-logo.svg' | asset_url }}" alt="{{ shop.name }}" class="storefront-header__logo" width="128" height="26">
      <h1>{{ 'general.password.title' | t }}</h1>
      <p>{{ 'general.password.message' | t }}</p>
      {% form 'storefront_password' %}
        {{ form.errors | default_errors }}
        <label class="storefront-field">
          <span>{{ 'general.password.label' | t }}</span>
          <input type="password" name="password" autocomplete="current-password">
        </label>
        <button type="submit" class="storefront-btn storefront-btn--primary">{{ 'general.password.submit' | t }}</button>
      {% endform %}
    </main>
  </body>
</html>
