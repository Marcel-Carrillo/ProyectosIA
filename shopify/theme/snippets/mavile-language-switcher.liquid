<div class="storefront-lang-switcher" role="group" aria-label="{{ 'general.language.label' | t }}">
  {% form 'localization' %}
    {% for language in localization.available_languages %}
      <button
        type="submit"
        name="locale_code"
        value="{{ language.iso_code }}"
        class="storefront-lang-switcher__btn{% if language.iso_code == localization.language.iso_code %} storefront-lang-switcher__btn--active{% endif %}"
        aria-label="{{ language.endonym_name }}"
        aria-pressed="{% if language.iso_code == localization.language.iso_code %}true{% else %}false{% endif %}"
        title="{{ language.endonym_name }}"
      >
        {% if language.iso_code == 'es' %}
          <svg class="storefront-lang-switcher__flag" viewBox="0 0 21 14" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <rect width="21" height="14" fill="#c60b1e"></rect>
            <rect y="3.5" width="21" height="7" fill="#ffc400"></rect>
          </svg>
        {% else %}
          <svg class="storefront-lang-switcher__flag" viewBox="0 0 60 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <rect width="60" height="40" fill="#012169"></rect>
            <path d="M0 0 L60 40 M60 0 L0 40" stroke="#fff" stroke-width="8"></path>
            <path d="M0 0 L60 40 M60 0 L0 40" stroke="#C8102E" stroke-width="5"></path>
            <path d="M30 0 V40 M0 20 H60" stroke="#fff" stroke-width="13"></path>
            <path d="M30 0 V40 M0 20 H60" stroke="#C8102E" stroke-width="7"></path>
          </svg>
        {% endif %}
      </button>
    {% endfor %}
  {% endform %}
</div>
