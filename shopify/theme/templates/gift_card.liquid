{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <title>{{ 'gift_cards.issued.title' | t }}</title>
    {{ 'mavile-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'mavile-base.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="storefront-root">
    <main class="storefront-account">
      <h1>{{ shop.name }}</h1>
      <p>{{ gift_card.balance | money }}</p>
      <p>{{ gift_card.code | format_code }}</p>
    </main>
  </body>
</html>
