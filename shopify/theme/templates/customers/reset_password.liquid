<div class="storefront-account">
  <h1>{{ 'customer.reset.title' | t }}</h1>
  {% form 'reset_customer_password' %}
    {{ form.errors | default_errors }}
    <label class="storefront-field">
      <span>{{ 'customer.reset.password' | t }}</span>
      <input type="password" name="customer[password]" required>
    </label>
    <label class="storefront-field">
      <span>{{ 'customer.reset.password_confirm' | t }}</span>
      <input type="password" name="customer[password_confirmation]" required>
    </label>
    <button type="submit" class="storefront-btn storefront-btn--primary">{{ 'customer.reset.submit' | t }}</button>
  {% endform %}
</div>
